ppercase tracking-wider text-stone-400 bg-[#26272f] border-b border-white/5\">javascript</div><pre class=\"px-3.5 py-3 text-[11px] sm:text-[12px] leading-relaxed text-stone-100 font-mono overflow-x-auto whitespace-pre\">// &lt;form name=&quot;myform&quot;&gt;&lt;input name=&quot;mid&quot; id=&quot;mid&quot;&gt;&lt;/form&gt;\r\n\r\nlet mid = document.myform.mid.value;          // 1. name 사용 (form 이름.입력 이름)\r\nlet mid2 = myform.mid.value;                  //    document 생략 가능\r\nlet mid3 = document.getElementById(&quot;mid&quot;).value;   // 2. id 사용\r\nlet mid4 = document.querySelector(&quot;#mid&quot;).value;   // 3. CSS 선택자\r\nlet mid5 = $(&quot;#mid&quot;).val();                   // 4. jQuery</pre></div></div>\r\n<div class=\"py-5 border-t border-stone-100\"><div class=\"flex items-center gap-2 mb-3\"><div class=\"w-2 h-2 rounded-full bg-cyan-500\"></div><h2 class=\"text-sm font-bold text-stone-900 tracking-wide\">화면에 쓰기 · 바꾸기</h2></div><div class=\"my-3 rounded-xl overflow-hidden border border-stone-800/80 bg-[#1e1f26] shadow-sm\"><div class=\"px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-stone-400 bg-[#26272f] border-b border-white/5\">javascript</div><pre class=\"px-3.5 py-3 text-[11px] sm:text-[12px] leading-relaxed text-stone-100 font-mono overflow-x-auto whitespace-pre\">const demo = document.getElementById(&quot;demo&quot;);\r\ndemo.innerHTML = &quot;&lt;b&gt;굵게&lt;/b&gt;&quot;;     // HTML 코드로 해석\r\ndemo.textContent = &quot;&lt;b&gt;글자&lt;/b&gt;&quot;;   // 글자 그대로 (사용자 입력은 이쪽 — XSS 방지)\r\ndemo.style.color = &quot;red&quot;;\r\ndemo.classList.add(&quot;active&quot;);</pre></div></div>\r\n<div class=\"py-5 border-t border-stone-100\"><div class=\"flex items-center gap-2 mb-3\"><div class=\"w-2 h-2 rounded-full bg-cyan-500\"></div><h2 class=\"text-sm font-bold text-stone-900 tracking-wide\">이벤트</h2></div><div class=\"my-3 rounded-xl overflow-hidden border border-stone-800/80 bg-[#1e1f26] shadow-sm\"><div class=\"px-3 py-1.5 text-[10px] 
border-b border-white/5\">javascript</div><pre class=\"px-3.5 py-3 text-[11px] sm:text-[12px] leading-relaxed text-stone-100 font-mono overflow-x-auto whitespace-pre\">console.log(&quot;값&quot;, value);       // 개발자 도구 콘솔\r\nconsole.error(&quot;오류&quot;);\r\nconsole.table(list);            // 배열 · 객체를 표로\r\nconsole.time(&quot;t&quot;); /* … */ console.timeEnd(&quot;t&quot;);   // 걸린 시간\r\n\r\nalert(&quot;안내&quot;);                  // 확인 창 (화면이 멈춤)\r\nif (confirm(&quot;삭제할까요?&quot;)) { }  // 확인 / 취소</pre></div><p class=\"text-xs sm:text-sm text-stone-600 leading-relaxed\">alert 대신 모달 창으로 띄우면 뒤 배경이 보여 더 보기 좋다</p><p class=\"text-xs sm:text-sm text-stone-600 leading-relaxed\"><span class='text-stone-500'>관련:</span> Java › 로그</p></div>\r\n","path":"it/syntax/javascript/log/log","breadcrumb":[{"id":"root","title":"Home","path":""},{"id":"it","title":"IT","path":"it"},{"id":"syntax","title":"프로그램 언어(문법)","path":"it/syntax"},{"id":"javascript","title":"JAVASCRIPT","path":"it/syntax/javascript"},{"id":"log","title":"로그","path":"it/syntax/javascript/log"}],"hasImage":false}
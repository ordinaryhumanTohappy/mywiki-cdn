sm:text-[12px] leading-relaxed text-stone-100 font-mono overflow-x-auto whitespace-pre\">nums: list[int] = [1, 2, 3]\r\nnums.append(4)\r\nnums[-1]            # 4 — 뒤에서부터\r\nnums[1:3]           # [2, 3] — 슬라이싱\r\nlen(nums)\r\n\r\ndoubled = [n * 2 for n in nums]              # 리스트 컴프리헨션 (map)\r\nevens = [n for n in nums if n % 2 == 0]      # filter\r\ntotal = sum(nums)\r\nfirst, *rest = nums                          # 언패킹</pre></div><p class=\"text-xs sm:text-sm text-stone-600 leading-relaxed\"><span class='text-stone-500'>관련:</span> TypeScript › 배열, Java › List</p></div>\r\n","path":"it/syntax/python/object/list","breadcrumb":[{"id":"root","title":"Home","path":""},{"id":"it","title":"IT","path":"it"},{"id":"syntax","title":"프로그램 언어(문법)","path":"it/syntax"},{"id":"python","title":"PYTHON","path":"it/syntax/python"},{"id":"object","title":"객체 · 컬렉션","path":"it/syntax/python/object"}],"hasImage":false}
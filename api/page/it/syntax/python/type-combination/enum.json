py-3 text-[11px] sm:text-[12px] leading-relaxed text-stone-100 font-mono overflow-x-auto whitespace-pre\">from enum import Enum, auto\r\n\r\nclass Status(Enum):\r\n    READY = &quot;ready&quot;\r\n    RUNNING = auto()\r\n    DONE = auto()\r\n\r\ns = Status.READY\r\ns.value             # &quot;ready&quot;\r\nStatus(&quot;ready&quot;)     # 값으로 찾기\r\nfor st in Status: print(st.name)\r\n\r\nmatch s:            # 3.10+ 패턴 매칭\r\n    case Status.READY: start()\r\n    case _: pass</pre></div><p class=\"text-xs sm:text-sm text-stone-600 leading-relaxed\"><span class='text-stone-500'>관련:</span> TypeScript › 열거형, Java › enum</p></div>\r\n","path":"it/syntax/python/type-combination/enum","breadcrumb":[{"id":"root","title":"Home","path":""},{"id":"it","title":"IT","path":"it"},{"id":"syntax","title":"프로그램 언어(문법)","path":"it/syntax"},{"id":"python","title":"PYTHON","path":"it/syntax/python"},{"id":"type-combination","title":"타입 조합 · 제한","path":"it/syntax/python/type-combination"}],"hasImage":false}
hite/5\">html</div><pre class=\"px-3.5 py-3 text-[11px] sm:text-[12px] leading-relaxed text-stone-100 font-mono overflow-x-auto whitespace-pre\">&lt;a href=&quot;b4Path/btom/23&quot;&gt;b4 호출&lt;/a&gt;</pre></div><div class=\"my-3 rounded-xl overflow-hidden border border-stone-800/80 bg-[#1e1f26] shadow-sm\"><div class=\"px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-stone-400 bg-[#26272f] border-b border-white/5\">java</div><pre class=\"px-3.5 py-3 text-[11px] sm:text-[12px] leading-relaxed text-stone-100 font-mono overflow-x-auto whitespace-pre\">@RequestMapping(value = &quot;/b4Path/{name}/{age}&quot;, method = RequestMethod.GET)\r\npublic String b4PathGet(Model model, @PathVariable String name, @PathVariable int age) {\r\n    model.addAttribute(&quot;name&quot;, name);   // &quot;btom&quot;\r\n    model.addAttribute(&quot;age&quot;, age);     // 23\r\n    return &quot;btom/b4&quot;;\r\n}</pre></div><p class=\"text-xs sm:text-sm text-stone-600 leading-relaxed\">쿼리스트링(?name=btom) 대신 주소 경로에 값을 넣는 REST 방식</p></div>\r\n","path":"it/syntax/spring/controller/path-variable","breadcrumb":[{"id":"root","title":"Home","path":""},{"id":"it","title":"IT","path":"it"},{"id":"syntax","title":"프로그램 언어(문법)","path":"it/syntax"},{"id":"spring","title":"SPRING","path":"it/syntax/spring"},{"id":"controller","title":"컨트롤러 · 데이터 통신","path":"it/syntax/spring/controller"}],"hasImage":false}